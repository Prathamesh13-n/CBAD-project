# Copy to .env (gitignored) and edit. Used by docker-compose.yml, and — placed at
# server/.env — by a plain `node server/index.js` run as well.

# --- Server -------------------------------------------------------------
# Host port the app is published on (docker compose only).
PORT=3000

# Real deployment: don't create demo data. The default admin (ADMIN001 / admin123)
# is still created — sign in, CHANGE ITS PASSWORD, then add faculty/students in the Admin Panel.
# Leave unset for a demo with sample students/faculty.
# SKIP_SEED=true

# Behind HTTPS (recommended on the internet): only send the session cookie over TLS,
# and trust the reverse proxy's X-Forwarded-* headers.
# COOKIE_SECURE=true
# TRUST_PROXY=true

# --- Appwrite file storage (optional) ------------------------------------
# Set ALL FOUR to store submitted files in an Appwrite bucket instead of local disk.
# Leave them unset to keep using server/data/uploads/. The API key needs the
# files.read and files.write scopes.
# APPWRITE_ENDPOINT=https://appwrite.example.com/v1
# APPWRITE_PROJECT_ID=
# APPWRITE_API_KEY=
# APPWRITE_BUCKET_ID=
